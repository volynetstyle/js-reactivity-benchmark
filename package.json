{
  "name": "js-reactivity-benchmark",
  "version": "4.0.0",
  "description": "JavaScript reactivity benchmarks with configurable workloads, framework adapters, and HTML performance reports.",
  "main": "index.js",
  "scripts": {
    "test": "vitest run --pool=threads",
    "build": "node scripts/build.mjs",
    "run": "node --expose-gc dist/index.js",
    "bench": "npm run build && node scripts/bench-and-update.mjs",
    "bench:smoke": "node scripts/benchmark-smoke.mjs",
    "results:page": "node scripts/render-results-page.mjs"
  },
  "keywords": [
    "benchmark",
    "reactivity",
    "signals",
    "javascript",
    "performance"
  ],
  "author": "Andrii Volynets (https://github.com/volynetstyle)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/volynetstyle/js-reactivity-benchmark.git"
  },
  "homepage": "https://github.com/volynetstyle/js-reactivity-benchmark#readme",
  "bugs": {
    "url": "https://github.com/volynetstyle/js-reactivity-benchmark/issues"
  },
  "license": "MIT",
  "dependencies": {
    "@amadeus-it-group/tansu": "2.0.0",
    "@angular/core": "22.2.3",
    "@maverick-js/signals": "6.0.0",
    "@pravosleva/reactive-engine": "2.6.0-beta.2",
    "@preact/signals-core": "1.14.4",
    "@reactively/core": "0.0.8",
    "@reatom/core": "1001.3.0",
    "@solidjs/signals": "0.13.13",
    "@volynets/reflex": "3.0.1",
    "@vue/reactivity": "3.5.44",
    "@zakkster/lite-signal": "1.5.2",
    "alien-signals": "3.2.1",
    "anod": "0.9.1",
    "cellx": "2.4.0",
    "compostate": "1.0.0",
    "dalien-signals": "3.2.1",
    "kairo": "0.6.0-rc.0",
    "mobx": "7.1.0",
    "mol_wire_lib": "1.0.1820",
    "oby": "15.1.2",
    "rescript-signals": "3.1.4",
    "s-js": "0.4.9",
    "signal-polyfill": "0.2.2",
    "signia": "0.1.5",
    "solid-js": "1.9.17",
    "solid-js-2": "npm:solid-js@2.0.0-rc.17",
    "solid-signals-2": "npm:@solidjs/signals@2.0.0-rc.17",
    "svelte": "5.57.2",
    "usignal": "0.10.0",
    "valtio": "2.3.2",
    "vue-reactivity-3.6": "npm:@vue/reactivity@3.6.0-rc.12"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "esbuild": "0.28.2",
    "prettier": "3.9.10",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=22"
  }
}
