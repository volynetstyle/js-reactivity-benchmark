{
  "name": "js-reactivity-benchmark",
  "version": "1.0.0",
  "description": "JavaScript reactivity benchmarks with configurable workloads, framework adapters, and HTML performance reports.",
  "main": "index.js",
  "scripts": {
    "test": "vitest run --pool=threads",
    "build": "node scripts/build.mjs",
    "run": "node --expose-gc dist/index.js",
    "bench": "npm run build && node scripts/bench-and-update.mjs",
    "bench:smoke": "node scripts/benchmark-smoke.mjs",
    "results:page": "node scripts/render-results-page.mjs"
  },
  "keywords": ["benchmark", "reactivity", "signals", "javascript", "performance"],
  "author": "Andrii Volynets (https://github.com/volynetstyle)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/volynetstyle/js-reactivity-benchmark.git"
  },
  "homepage": "https://github.com/volynetstyle/js-reactivity-benchmark#readme",
  "bugs": {
    "url": "https://github.com/volynetstyle/js-reactivity-benchmark/issues"
  },
  "license": "MIT",
  "dependencies": {
    "@amadeus-it-group/tansu": "^2.0.0",
    "@angular/core": "22.0.4",
    "@preact/signals": "^2.0.0",
    "@reactively/core": "^0.0.8",
    "@solidjs/signals": "^0.13.11",
    "@volynets/reflex": "^1.0.0",
    "@vue/reactivity": "^3.5.13",
    "@zakkster/lite-signal": "1.3.0",
    "alien-signals": "3.2.1",
    "compostate": "0.6.0-alpha.1",
    "kairo": "0.6.0-rc.0",
    "lite-signals": "^1.0.4",
    "mitata": "1.0.34",
    "mobx": "^6.13.5",
    "mol_wire_lib": "^1.0.1259",
    "oby": "15.1.2",
    "preact": "^10.25.4",
    "random": "^5.1.1",
    "react": "^19.0.0",
    "s-js": "^0.4.9",
    "signal-polyfill": "^0.2.1",
    "signia": "^0.1.5",
    "solid-js": "^1.9.4",
    "svelte": "5.56.4",
    "usignal": "^0.10.0",
    "valtio": "^2.1.2"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "esbuild": "^0.28.1",
    "prettier": "^3.4.2",
    "vite": "^8.1.2",
    "vitest": "^4.1.4"
  }
}
